openapi: 3.1.0
info:
  title: Meilisearch Product Availability — Colombia Express
  version: "1.0"
  description: |
    Search API for product availability across Expressa Colombia stores.
    Backed by Meilisearch index `products-colombia`.

    ## Recommended usage pattern

    Send two queries in a single `/multi-search` call:
    - **Query 0** — existence check: no store filter, finds all active matching products.
    - **Query 1** — availability check: adds a `stores_with_stock IN [...]` filter for the
      Express stores of the target city.

    ### Decision logic on the response
    | Condition | Interpretation |
    |-----------|---------------|
    | City code not in the Express city map | City not covered |
    | `results[0].estimatedTotalHits == 0` | Product not found |
    | `results[0].estimatedTotalHits > 0` and `results[1].estimatedTotalHits == 0` | Product exists but no Express availability in that city |
    | `results[1].estimatedTotalHits > 0` | Product available in at least one store in the city |

    ## Express city map (cityCode → store IDs)

    ## Express city map (cityCode → store IDs)

    | City | Code | Store IDs |
    |------|------|-----------|
    | Cali | ALI | 91,92,93,94,1101,1107,1113,1137,1149,1169,1173 |
    | Jamundí | AMU | 1129 |
    | Armenia | ARM | 1159,1160 |
    | Barranquilla | BAR | 43,44,45,47,50,63,74,87,1102,1127,1147,1181 |
    | Bogotá | BOG | 2,3,4,6,7,9,11,14,15,16,19,20,22,23,24,26,27,29,30,31,37,39,40,41,42,46,53,54,60,67,68,80,81,83,85,88,89,99,1112,1115,1122,1135,1141,1154,1175,1190 |
    | Bucaramanga | BUC | 1130,1132,1133,1134 |
    | Chía | CHI | 28,1126 |
    | Cota | CTA | 1121 |
    | Cartagena | CTG | 64,71,72,1150,1188 |
    | Cúcuta | CUT | 1124,1128,1143,1146,1176,1186 |
    | Ibagué | IBA | 1177 |
    | Rionegro (Antioquia) | ION | 96,1148,1156 |
    | Cajicá | JIC | 1117 |
    | La Calera | LAC | 1118 |
    | Medellín | MED | 97,98,1100,1103,1106,1108,1109,1110,1114,1119,1131,1138,1155,1158,1184,1187 |
    | Sabaneta | NET | 1151,1189 |
    | Manizales | NIZ | 1162,1163,1164 |
    | Pereira | PER | 1161,1166,1168 |
    | Piedecuesta | PIE | 1165 |
    | Santa Marta | SMR | 62,76,1123 |
    | Soacha | SOA | 52 |
    | Soledad | SOL | 51 |
    | Los Patios | SPA | 1171 |
    | Montería | TER | 1125,1139,1172 |
    | Valledupar | VUP | 69,73,1140 |
    | Villavicencio | VVC | 1116 |

servers:
  - url: https://ms-e1f67fab2ccd-46082.nyc.meilisearch.io
    description: Meilisearch cloud instance (NYC)

security:
  - BearerAuth: []

paths:
  /multi-search:
    post:
      operationId: multiSearch
      summary: Search products across one or more queries in a single round-trip
      description: |
        Executes multiple search queries against the `products-colombia` index in a single
        HTTP request. Use two queries — one without and one with a city store filter — to
        determine both product existence and Express availability simultaneously.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/MultiSearchRequest"
            examples:
              dolex_bogota:
                summary: Search "dolex" with Bogotá Express availability check
                value:
                  queries:
                    - indexUid: products-colombia
                      q: dolex
                      limit: 5
                      filter:
                        - "status = A"
                        - "outofstore = false"
                      attributesToRetrieve:
                        - id
                        - objectID
                        - mediaDescription
                        - marca
                        - fullPriceByCity
                        - offerPriceByCity
                        - stores_with_stock
                        - stores_with_low_stock
                        - stores_with_offer
                    - indexUid: products-colombia
                      q: dolex
                      limit: 5
                      filter:
                        - "status = A"
                        - "outofstore = false"
                        - "stores_with_stock IN [2,3,4,6,7,9,11,14,15,16,19,20,22,23,24,26,27,29,30,31,37,39,40,41,42,46,53,54,60,67,68,80,81,83,85,88,89,99,1112,175,1190]"
                      attributesToRetrieve:
                        - id
                        - objectID
                        - mediaDescription
                        - marca
                        - fullPriceByCity
                        - offerPriceByCity
                        - stores_with_stock
                        - stores_with_low_stock
                        - stores_with_offer
      responses:
        "200":
          description: Search executed successfully (zero results is still a 200)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MultiSearchResponse"
              examples:
                hit_with_availability:
                  summary: Product found with Express availability
                  value:
                    results:
                      - indexUid: products-colombia
                        hits:
                          - objectID: "1000409"
                            id: "1000409"
                            mediaDescription: "Dolex Gripa Acetaminofen + Clorfeniramina + Fenilefrina 500mg/2mg/5mg x 12 Tabletas"
                            marca: Dolex
                            fullPriceByCity:
                              - cityCode: BOG
                                fullPrice: 18950
                            offerPriceByCity: []
                            stores_with_stock: [6, 23, 14, 2, 11, 30]
                            stores_with_low_stock: []
                            stores_with_offer: [26, 43, 51]
                        query: dolex
                        processingTimeMs: 3
                        limit: 5
                        offset: 0
                        processingTimeMs: 3
                        limit: 5
                        offset: 0
                        estimatedTotalHits: 15
                        requestUid: "019faf96-5d7f-7211-a676-983fe59832af"
                        metadata:
                          query: dolex
                          queryUid: "019faf96-5d82-7b90-b52c-63ae8d6ba28c"
                          indexUid: products-colombia
                          primaryKey: objectID
                no_results:
                  summary: Product not found
                  value:
                    results:
                      - indexUid: products-colombia
                        hits: []
                        query: "xyzabc123 producto inexistente"
                        processingTimeMs: 5
                        limit: 5
                        offset: 0
                        estimatedTotalHits: 0
                        requestUid: "019faf96-8ab6-7dc3-9a22-9123224ea403"
                        metadata:
                          query: "xyzabc123 producto inexistente"
                          queryUid: "019faf96-8abc-7313-9bb7-4bdb5b4a2845"
                          indexUid: products-colombia
                          primaryKey: objectID
        "400":
          description: |
            Malformed request. Common causes:
            - Top-level key is not `queries` (e.g. sending a flat query object)
            - `indexUid` missing or incorrect
            - Unsupported filter syntax
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "403":
          description: Forbidden — the API key does not have permission for this operation
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"

components:
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      description: >
        Meilisearch API key with search-only permissions on the `products-colombia` index.
        Administrative and configuration endpoints return 403 with this key.

  schemas:
    MultiSearchRequest:
      type: object
      required:
        - queries
      required:
        - queries
      properties:
        queries:
          type: array
          minItems: 1
          description: >
            List of search queries to execute. All run against the same Meilisearch instance
            but may target different indexes or apply different filters.
          items:
            $ref: "#/components/schemas/SearchQuery"

    SearchQuery:
      type: object
      required:
        - indexUid
        - q
      properties:
        indexUid:
          type: string
          description: Target index identifier.
          example: products-colombia
        q:
          type: string
          description: >
            Full-text search term (product name as provided by the customer).
            Note: Meilisearch is typo-tolerant but significant misspellings (e.g. "doleks"
            for "dolex") may miss results — confirm the product name before querying.
          example: dolex
        limit:
          type: integer
          minimum: 1
          default: 20
          description: Maximum number of hits to return.
          example: 5
        offset:
          type: integer
          minimum: 0
          default: 0
          description: Number of hits to skip (for pagination).
        filter:
          type: array
          description: >
            Array of filter expressions. Each element is either a string (a single
            filter expression) or an array of strings (OR group).
            Common expressions:
            - `"status = A"` — active products only
            - `"outofstore = false"` — exclude permanently delisted items
            - `"stores_with_stock IN [id1,id2,...]"` — limit to stores that have stock
          items:
            oneOf:
              - type: string
              - type: array
                items:
                  type: string
          example:
            - "status = A"
            - "outofstore = false"
            - "stores_with_stock IN [2,3,4,6,7]"
        attributesToRetrieve:
          type: array
          description: >
            Fields to include in each hit. Omitting this returns all stored attributes.
            Always send this to keep response payloads small.
          items:
            type: string
            enum:
              - id
              - objectID
              - mediaDescription
              - marca
              - fullPriceByCity
              - offerPriceByCity
              - stores_with_stock
              - stores_with_low_stock
              - stores_with_offer
              - status
              - outofstore
          example:
            - id
            - objectID
            - mediaDescription
            - marca
            - fullPriceByCity
            - offerPriceByCity
            - stores_with_stock
            - stores_with_low_stock
            - stores_with_offer

    MultiSearchResponse:
      type: object
      required:
        - results
      properties:
        results:
          type: array
          description: >
            One result object per query, in the same order as the request `queries` array.
          items:
            $ref: "#/components/schemas/SearchResult"

    SearchResult:
      type: object
      required:
        - indexUid
        - hits
        - query
        - processingTimeMs
        - limit
        - offset
        - estimatedTotalHits
      properties:
        indexUid:
          type: string
          description: Index that was searched.
          example: products-colombia
        hits:
          type: array
          description: Matching product documents, up to `limit` entries.
          items:
            $ref: "#/components/schemas/ProductHit"
        query:
          type: string
          description: The search term that was submitted.
          example: dolex
        processingTimeMs:
          type: integer
          description: Server-side search time in milliseconds (typically 3–5 ms).
          example: 3
        limit:
          type: integer
          description: Maximum hits that could be returned (mirrors the request value).
          example: 5
        offset:
          type: integer
          description: Number of hits skipped.
          example: 0
        estimatedTotalHits:
          type: integer
          description: >
            Estimated total number of matching documents in the index (not capped by `limit`).
            Use this — not `hits.length` — for existence and availability checks.
          example: 15
        requestUid:
          type: string
          description: Opaque identifier for the overall multi-search request.
          example: "019faf96-5d7f-7211-a676-983fe59832af"
        metadata:
          $ref: "#/components/schemas/SearchMetadata"

    ProductHit:
      type: object
      description: A single product document returned by the index.
      properties:
        objectID:
          type: string
          description: Primary key of the product (string form of the numeric ID).
          example: "1000409"
        id:
          type: string
          description: Product identifier — mirrors `objectID`.
          example: "1000409"
        mediaDescription:
          type: string
          description: Full product name including brand, active ingredients, format, and pack size.
          example: "Dolex Gripa Acetaminofen + Clorfeniramina + Fenilefrina 500mg/2mg/5mg x 12 Tabletas"
        marca:
          type: string
          description: Brand name.
          example: Dolex
        fullPriceByCity:
          type: array
          description: >
            Regular (non-offer) retail price per city. Select the element whose `cityCode`
            matches the customer's city and use `fullPrice` as the shelf price.
          items:
            $ref: "#/components/schemas/CityPrice"
        offerPriceByCity:
          type: array
          description: >
            Promotional price per city. Only apply when the queried store also appears in
            `stores_with_offer`. May be an empty array when no city-level offer price is set.
          items:
            $ref: "#/components/schemas/CityOfferPrice"
        stores_with_stock:
          type: array
          description: >
            Store IDs that currently carry this product. Used in the `stores_with_stock IN [...]`
            filter to check city-specific availability.
          items:
            type: integer
          example: [6, 23, 14, 2, 11, 30, 54]
        stores_with_low_stock:
          type: array
          description: >
            Subset of `stores_with_stock` where inventory is low. Meilisearch does not
            expose exact unit counts.
          items:
            type: integer
          example: [1175, 1125]
        stores_with_offer:
          type: array
          description: >
            Store IDs where a promotional price is active. Cross-reference with `stores_with_stock`
            for the queried city stores — an offer is relevant only when the store appears in both.
          items:
            type: integer
          example: [26, 43, 51, 52, 62]

    CityPrice:
      type: object
      required:
        - cityCode
        - fullPrice
      properties:
        cityCode:
          type: string
          description: >
            Three-letter city code matching the Express city map (e.g. BOG, MED, ALI).
            Use this to look up the price for the customer's city.
          example: BOG
        fullPrice:
          type: integer
          description: Regular retail price in Colombian pesos (COP), no decimals.
          example: 18950

    CityOfferPrice:
      type: object
      required:
        - cityCode
        - offerPrice
      properties:
        cityCode:
          type: string
          description: Three-letter city code (same coding as `fullPriceByCity`).
          example: BOG
        offerPrice:
          type: integer
          description: Promotional price in Colombian pesos (COP), no decimals.
          example: 15900

    SearchMetadata:
      type: object
      properties:
        query:
          type: string
          description: Search term echoed back.
          example: dolex
        queryUid:
          type: string
          description: Opaque identifier for this specific query within the multi-search.
          example: "019faf96-5d82-7b90-b52c-63ae8d6ba28c"
        indexUid:
          type: string
          description: Index that was searched.
          example: products-colombia
        primaryKey:
          type: string
          description: Field used as the document primary key in this index.
          example: objectID

    ErrorResponse:
      type: object
      properties:
        message:
          type: string
          description: Human-readable error description.
        code:
          type: string
          description: Machine-readable error code (Meilisearch error taxonomy).
        type:
          type: string
          description: Error type category.
        link:
          type: string
          format: uri
          description: Link to Meilisearch documentation for this error.
